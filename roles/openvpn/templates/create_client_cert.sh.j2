#!/usr/bin/env bash

set -ex

if [ "$1" = "" ]; then
  echo "Usage: $0 <username>"
  exit 1
fi

USER=$1
SERVER={{ openvpn_server_addr }}

cd /etc/openvpn/easy-rsa
./easyrsa build-client-full $USER nopass
cd -

echo "# $USER
client
tls-client
nobind
verb {{ openvpn_server_conf_verb }}
dev {{ openvpn_server_conf_dev }}
remote $SERVER {{ openvpn_server_conf_port }} {{ openvpn_server_conf_proto }}
data-ciphers {{ openvpn_server_conf_cipher }}

<ca>
$(sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' /etc/openvpn/easy-rsa/pki/ca.crt)
</ca>

<cert>
$(sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' /etc/openvpn/easy-rsa/pki/issued/$USER.crt)
</cert>

<key>
$(sed -n '/BEGIN PRIVATE KEY/,/END PRIVATE KEY/p' /etc/openvpn/easy-rsa/pki/private/$USER.key)
</key>" > /etc/openvpn/client/$USER.ovpn" > /etc/openvpn/client/$USER.ovpn
